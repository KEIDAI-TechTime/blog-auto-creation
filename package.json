  "version": "1.0.0",
  "description": "TechTimeブログ記事作成自動化CLIツール",
  "main": "dist/index.js",
  "bin": {
    "techtime-blog": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
